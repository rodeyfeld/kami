# --- Secrets ---
# No secrets currently required for Kami

# --- Configs ---
# --- Application settings ---

# Kubernetes namespace to monitor (defaults to "galaxy" if not set)
KAMI_NAMESPACE=galaxy

# --- Local Development ---
# When running locally via docker compose, mount your kubeconfig
# The compose.yml file automatically mounts ~/.kube for local k8s access
# 
# If you don't have a local k8s cluster, Kami will run in standalone mode
# and show a warning that K8s monitoring is unavailable

