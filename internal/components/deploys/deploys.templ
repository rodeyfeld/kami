package deploys

import (
	"fmt"
	"kami/internal/components/layout"
	"kami/internal/k8s"
	"kami/internal/woodpecker"
	"strings"
	"time"
)

templ Page() {
	@layout.Base("deploys", "deploys") {
		<div class="space-y-10">
			<div
				hx-get="/partials/deploys"
				hx-trigger="load, every 5s"
				hx-swap="none"
				hx-select-oob="#deploys-error,#in-progress,#rollouts,#steps,#deploys-updated"
			></div>
			<div id="deploys-error"></div>
			<div id="in-progress">
				@spinner()
			</div>
			<div class="grid gap-16 lg:grid-cols-5">
				<section class="lg:col-span-3 min-w-0">
					<h2 class="eyebrow">rollouts</h2>
					<p class="text-xs text-base-content/30 mt-1 mb-6">each restart or spec change is a new revision</p>
					<div id="rollouts"></div>
				</section>
				<section class="lg:col-span-2 min-w-0">
					<div id="steps"></div>
				</section>
			</div>
			<p class="eyebrow text-center">
				<span id="deploys-updated">…</span> · every 5s
			</p>
		</div>
	}
}

templ spinner() {
	<div class="flex justify-center py-10 text-base-content/40">
		<span class="dot breathe-fast"></span>
	</div>
}

templ Unavailable(message string) {
	<div id="deploys-error" class="notice border-warning/50">
		<p class="text-warning">deploy tracking unavailable</p>
		<p class="font-mono text-xs text-base-content/50 break-all mt-1">{ message }</p>
	</div>
	<div id="in-progress"></div>
	<div id="rollouts"></div>
	<div id="steps"></div>
}

templ Content(d *k8s.Deploys) {
	<div id="deploys-error">
		if d.Error != "" {
			<div class="notice border-error/50">
				<p class="font-mono text-xs text-error break-all">{ d.Error }</p>
			</div>
		}
	</div>
	<div id="in-progress">
		@InProgress(inProgress(d.Rollouts), activePipelines(d.Pipelines))
	</div>
	<div id="rollouts">
		@RolloutTable(history(d.Rollouts))
	</div>
	<div id="steps">
		if d.CI != nil && len(d.Pipelines) > 0 {
			<h2 class="eyebrow">pipelines</h2>
			<p class="text-xs text-base-content/30 mt-1 mb-6">recent woodpecker runs across every public repo</p>
			@ciWarning(d.CI)
			@PipelineList(d.Pipelines)
		} else {
			<h2 class="eyebrow">pipeline steps</h2>
			<p class="text-xs text-base-content/30 mt-1 mb-6">woodpecker steps seen running in the cluster</p>
			if d.CI != nil {
				@ciWarning(d.CI)
			}
			@StepTable(d.Steps)
		}
	</div>
	<span id="deploys-updated">{ d.UpdatedAt.Format("15:04:05 UTC") }</span>
}

templ InProgress(rollouts []k8s.Rollout, pipelines []woodpecker.PipelineView) {
	if len(rollouts) == 0 && len(pipelines) == 0 {
		<p class="text-center font-serif text-lg tracking-widest text-base-content/30">all is still</p>
	} else {
		<div class="space-y-8">
			for _, p := range pipelines {
				@activePipeline(p)
			}
			for _, r := range rollouts {
				<div class={ "border-l pl-5", templ.KV("border-error/60", r.State == k8s.RolloutStuck), templ.KV("border-info/60", r.State == k8s.RolloutRolling) }>
					<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
						if r.State == k8s.RolloutStuck {
							<span class="state text-error"><span class="dot"></span>stuck</span>
						} else {
							<span class="state text-info"><span class="dot breathe-fast"></span>rolling</span>
						}
						<span class="font-mono">{ r.Workload }</span>
						if r.Revision > 0 {
							<span class="text-xs text-base-content/40">{ fmt.Sprintf("rev %d", r.Revision) }</span>
						}
						<span class="font-mono text-xs text-base-content/60">{ fmt.Sprintf("%d/%d ready", r.Ready, r.Desired) }</span>
						<span class="text-xs text-base-content/40">{ "started " + k8s.HumanizeAge(time.Since(r.StartedAt)) }</span>
					</div>
					if r.Pipeline != nil {
						<div class="mt-2 text-xs">
							@pipelineRef(r.Pipeline, true)
						</div>
					}
					if r.Reason != "" {
						<div class="mt-2 font-mono text-xs text-error/90 break-all">{ r.Reason }</div>
					}
				</div>
			}
		</div>
	}
}

templ RolloutTable(rollouts []k8s.Rollout) {
	<div class="overflow-x-auto">
		<table class="quiet-table">
			<thead>
				<tr>
					<th>workload</th>
					<th>result</th>
					<th class="hidden sm:table-cell">image</th>
					<th>when</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rollouts {
					<tr class={ templ.KV("opacity-40", r.State == k8s.RolloutSuperseded) }>
						<td>
							<div class="font-mono text-[13px] whitespace-nowrap">{ r.Workload }</div>
							<div class="text-xs text-base-content/40 mt-0.5">
								if r.Revision > 0 {
									{ fmt.Sprintf("rev %d", r.Revision) }
								}
								if r.Trigger != "" {
									{ " · " + r.Trigger }
								}
								if r.Unmatched {
									<span title="No Woodpecker step was running when this revision was created: a manual kubectl restart or apply, or a private repo kami can't see">· manual</span>
								}
							</div>
							if r.Pipeline != nil {
								<div class="text-xs mt-1">
									@pipelineRef(r.Pipeline, false)
								</div>
							}
						</td>
						<td class="whitespace-nowrap">
							@result(r)
						</td>
						<td class="hidden sm:table-cell">
							@image(r)
						</td>
						<td class="text-xs text-base-content/40 whitespace-nowrap" title={ r.StartedAt.Format(time.RFC3339) }>
							{ k8s.HumanizeAge(time.Since(r.StartedAt)) }
						</td>
					</tr>
				}
				if len(rollouts) == 0 {
					<tr>
						<td colspan="4" class="text-center py-10 text-base-content/40">no rollouts</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ result(r k8s.Rollout) {
	switch r.State {
		case k8s.RolloutDone:
			if r.Desired == 0 {
				<span class="state text-base-content/30"><span class="dot-hollow"></span>scaled to 0</span>
			} else {
				<span class="state text-success"><span class="dot breathe"></span>live</span>
			}
		case k8s.RolloutSuperseded:
			<span class="state text-base-content/40"><span class="dot-hollow"></span>replaced</span>
		case k8s.RolloutWaiting:
			<span class="state text-warning" title={ r.Reason }><span class="dot-hollow"></span>waits for pod delete</span>
		default:
			<span class="state text-info"><span class="dot"></span>{ r.State }</span>
	}
	if r.ReadyAt != nil && r.ReadyAt.After(r.StartedAt) {
		<div class="text-xs text-base-content/30 mt-0.5 pl-3.5">{ "ready in " + shortDuration(r.ReadyAt.Sub(r.StartedAt)) }</div>
	}
}

// image shows whether a revision runs a new build. Every image is pushed as :latest, so a restart
// with an unchanged digest means the pipeline restarted the old build.
templ image(r k8s.Rollout) {
	<div class="whitespace-nowrap text-xs">
		if changed := r.ImageChanged(); changed != nil {
			if *changed {
				<div class="text-success/80">new build</div>
			} else {
				<div class="text-warning/80" title="Restarted, but the pod pulled the same image as the previous revision">same build</div>
			}
		}
		if r.Digest != "" {
			<div class="font-mono text-base-content/30 mt-0.5" title={ r.Digest }>{ shortDigest(r.Digest) }</div>
		} else if r.ImageChanged() == nil {
			<span class="text-base-content/20">—</span>
		}
	</div>
}

templ StepTable(steps []k8s.Step) {
	<div class="overflow-x-auto">
		<table class="quiet-table">
			<thead>
				<tr>
					<th>repo</th>
					<th>step</th>
					<th>status</th>
					<th>when</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range steps {
					<tr>
						<td class="font-mono text-[13px]">{ s.Repo }</td>
						<td class="font-mono text-[13px] text-base-content/70">{ s.Name }</td>
						<td>
							@stepStatus(s)
						</td>
						<td class="text-xs text-base-content/40 whitespace-nowrap" title={ s.StartedAt.Format(time.RFC3339) }>
							{ k8s.HumanizeAge(time.Since(s.StartedAt)) }
						</td>
					</tr>
				}
				if len(steps) == 0 {
					<tr>
						<td colspan="4" class="text-center py-10 text-xs text-base-content/40">
							No steps since kami started. Woodpecker deletes step pods when they finish, so kami only knows about steps it saw.
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ stepStatus(s k8s.Step) {
	switch s.Phase {
		case "Succeeded":
			<span class="state text-success"><span class="dot"></span>{ stepDuration(s) }</span>
		case "Failed":
			<span class="state text-error"><span class="dot"></span>{ stepDuration(s) }</span>
		case "Running":
			<span class="state text-info"><span class="dot breathe-fast"></span>{ stepDuration(s) }</span>
		default:
			<span class="state text-base-content/40"><span class="dot-hollow"></span>{ stepDuration(s) }</span>
	}
	if s.Reason != "" {
		<div class="text-xs font-mono text-error/90 break-all mt-0.5">{ s.Reason }</div>
	}
}

func inProgress(rollouts []k8s.Rollout) []k8s.Rollout {
	out := make([]k8s.Rollout, 0)
	for _, r := range rollouts {
		if r.InProgress() {
			out = append(out, r)
		}
	}
	return out
}

func history(rollouts []k8s.Rollout) []k8s.Rollout {
	out := make([]k8s.Rollout, 0, len(rollouts))
	for _, r := range rollouts {
		if !r.InProgress() {
			out = append(out, r)
		}
	}
	return out
}

func stepDuration(s k8s.Step) string {
	if s.FinishedAt != nil {
		return shortDuration(s.FinishedAt.Sub(s.StartedAt))
	}
	if s.Phase == "Running" {
		return shortDuration(time.Since(s.StartedAt))
	}
	return strings.ToLower(s.Phase)
}

func shortDuration(d time.Duration) string {
	d = d.Round(time.Second)
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm%02ds", int(d.Minutes()), int(d.Seconds())%60)
	}
	return fmt.Sprintf("%dh%02dm", int(d.Hours()), int(d.Minutes())%60)
}

func shortDigest(digest string) string {
	hex := strings.TrimPrefix(digest, "sha256:")
	if len(hex) > 12 {
		hex = hex[:12]
	}
	return hex
}

// pipelineRef links a rollout to the run that caused it. A run from another repo is mirage restarting everything.
templ pipelineRef(p *woodpecker.PipelineView, withMessage bool) {
	<a href={ templ.SafeURL(p.URL) } target="_blank" title={ p.Message } class="quiet-link text-base-content/40 inline-flex items-baseline gap-2 whitespace-nowrap max-w-full">
		<span class="font-mono">{ fmt.Sprintf("%s #%d", p.Repo, p.Number) }</span>
		<span class="font-mono text-base-content/25">{ p.Commit }</span>
		if withMessage {
			<span class="truncate max-w-md">{ p.Message }</span>
		}
	</a>
}

templ activePipeline(p woodpecker.PipelineView) {
	<div class={ "border-l pl-5", templ.KV("border-warning/60", p.Queued()), templ.KV("border-info/60", !p.Queued()) }>
		<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
			if p.Queued() {
				<span class="state text-warning"><span class="dot"></span>queued</span>
			} else {
				<span class="state text-info"><span class="dot breathe-fast"></span>building</span>
			}
			<a href={ templ.SafeURL(p.URL) } target="_blank" class="quiet-link font-mono">{ fmt.Sprintf("%s #%d", p.Repo, p.Number) }</a>
			<span class="font-mono text-xs text-base-content/30">{ p.Commit }</span>
			<span class="text-sm text-base-content/70 truncate max-w-md" title={ p.Message }>{ p.Message }</span>
			<span class="text-xs text-base-content/40">{ k8s.HumanizeAge(time.Since(p.Created)) }</span>
		</div>
		<div class="mt-2">
			@stepChips(p.Steps)
		</div>
		if p.Queued() {
			<p class="mt-2 text-xs text-warning/90">Waiting to start for over 2 minutes. Check that ouroboros-agent is running and can create pods.</p>
		}
	</div>
}

templ ciWarning(s *woodpecker.Status) {
	if s.Error != "" {
		<div class="notice border-warning/50 mb-6">
			<p class="text-xs text-warning">can't follow woodpecker</p>
			<p class="font-mono text-xs text-base-content/50 break-all">{ s.Error }</p>
		</div>
	}
}

templ PipelineList(pipelines []woodpecker.PipelineView) {
	<ul>
		for _, p := range pipelines {
			<li class="py-4 border-t border-base-content/5 first:border-t-0 first:pt-0">
				<div class="flex items-baseline gap-3 text-sm">
					@pipelineIcon(p.Status)
					<a href={ templ.SafeURL(p.URL) } target="_blank" class="quiet-link font-mono text-[13px]">{ fmt.Sprintf("%s #%d", p.Repo, p.Number) }</a>
					if p.CommitURL != "" {
						<a href={ templ.SafeURL(p.CommitURL) } target="_blank" class="quiet-link font-mono text-xs text-base-content/30">{ p.Commit }</a>
					}
					<span class="ml-auto text-xs text-base-content/30 whitespace-nowrap" title={ p.Created.Format(time.RFC3339) }>{ k8s.HumanizeAge(time.Since(p.Created)) }</span>
				</div>
				<div class="text-sm text-base-content/60 truncate mt-1 pl-[18px]" title={ p.Message }>{ p.Message }</div>
				<div class="mt-2 pl-[18px] flex items-baseline gap-3">
					@stepChips(p.Steps)
					if p.Event != "push" {
						<span class="eyebrow">{ p.Event }</span>
					}
				</div>
				if p.FailedStep != "" && len(p.LogTail) > 0 {
					<details class="mt-3 pl-[18px]" open?={ time.Since(p.Created) < time.Hour }>
						<summary class="text-xs text-error/80 cursor-pointer">{ "last lines of " + p.FailedStep }</summary>
						<pre class="mt-2 font-mono text-[11px] leading-relaxed text-base-content/50 border-l border-error/30 pl-3 overflow-x-auto max-h-64">{ strings.Join(p.LogTail, "\n") }</pre>
					</details>
				}
			</li>
		}
	</ul>
}

templ pipelineIcon(status string) {
	switch status {
		case "success":
			<span class="text-success" title={ status }><span class="dot"></span></span>
		case "failure", "error", "killed":
			<span class="text-error" title={ status }><span class="dot"></span></span>
		case "running":
			<span class="text-info" title={ status }><span class="dot breathe-fast"></span></span>
		case "pending", "created":
			<span class="text-warning" title={ status }><span class="dot-hollow"></span></span>
		default:
			<span class="text-base-content/30" title={ status }><span class="dot-hollow"></span></span>
	}
}

// stepChips lists steps as quiet words tinted by state, with how long each took
templ stepChips(steps []woodpecker.StepView) {
	<div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
		for _, s := range steps {
			<span class={ stepClass(s.State) } title={ stepTitle(s) }>
				{ s.Name }
				if s.Duration != nil {
					<span class="text-base-content/25">{ shortDuration(*s.Duration) }</span>
				}
			</span>
		}
	</div>
}

func activePipelines(pipelines []woodpecker.PipelineView) []woodpecker.PipelineView {
	out := make([]woodpecker.PipelineView, 0)
	for _, p := range pipelines {
		if p.Running() {
			out = append(out, p)
		}
	}
	return out
}

func stepClass(state string) string {
	switch state {
	case "success":
		return "text-success/80"
	case "failure", "error", "killed":
		return "text-error"
	case "running":
		return "text-info breathe-fast"
	default:
		return "text-base-content/30"
	}
}

func stepTitle(s woodpecker.StepView) string {
	switch {
	case s.Error != "":
		return s.State + ": " + s.Error
	case s.ExitCode != 0:
		return fmt.Sprintf("%s: exit %d", s.State, s.ExitCode)
	default:
		return s.State
	}
}
