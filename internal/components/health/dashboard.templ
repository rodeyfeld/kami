package health

import (
	"fmt"
	"kami/internal/components/layout"
	"kami/internal/k8s"
	"kami/internal/monitor"
	"math"
	"sort"
	"strings"
	"time"
)

templ Dashboard(mode string) {
	@layout.Base("health", "health") {
		<div class="space-y-10">
			<!-- One poller refreshes every region with a single request -->
			<div
				hx-get="/partials/status"
				hx-trigger="load, every 10s"
				hx-swap="none"
				hx-select-oob="#summary,#resources-container,#last-update"
			></div>
			if mode == "docker" {
				<p class="eyebrow">local docker mode</p>
			}
			<div id="summary">
				@spinner()
			</div>
			<div id="resources-container"></div>
			<p class="eyebrow text-center">
				<span id="last-update">…</span> · every 10s
			</p>
		</div>
	}
}

templ spinner() {
	<div class="flex justify-center py-10 text-base-content/40">
		<span class="dot breathe-fast"></span>
	</div>
}

templ StandaloneMode() {
	<div id="summary" class="notice border-warning/50">
		<p class="text-warning">standalone</p>
		<p class="text-base-content/50">No Kubernetes client, so there is no cluster to watch.</p>
	</div>
}

templ ErrorState(message string) {
	<div id="summary" class="notice border-error/50">
		<p class="text-error">can't read cluster status</p>
		<p class="font-mono text-xs text-base-content/50 break-all mt-1">{ message }</p>
	</div>
}

templ StatusCards(status *monitor.Status, mode string) {
	<div id="summary" class="flex flex-wrap items-center gap-x-16 gap-y-10">
		@upRing(status, mode)
		<div class="space-y-4">
			@count("degraded", status.DegradedCount, "text-warning", "")
			@count("down", status.DownCount, "text-error", "")
			if mode == "kubernetes" {
				@count("unverified", status.UnverifiedCount, "text-warning", "Up, but kami can't call their health check")
			}
		</div>
	</div>
	<div id="resources-container">
		@ResourceTable(groupResources(status.Resources), mode)
	</div>
	<span id="last-update">{ status.UpdatedAt.Format("15:04:05 UTC") }</span>
}

// upRing places one dot per component around a circle, tinted by its health, with the share up at its center
templ upRing(status *monitor.Status, mode string) {
	<div class="relative w-44 h-44 shrink-0">
		<svg viewBox="0 0 100 100" class="absolute inset-0" aria-hidden="true">
			<circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="0.3" class="text-base-content/10"></circle>
			for _, d := range ringDots(status.Resources, mode) {
				<circle cx={ d.X } cy={ d.Y } r={ d.R } fill="currentColor" class={ "ring-dot", d.Class }>
					<title>{ d.Name }</title>
				</circle>
			}
		</svg>
		<div class="absolute inset-0 flex flex-col items-center justify-center">
			<div class="flex items-start font-serif leading-none">
				<span class="text-5xl text-base-content/90">{ fmt.Sprint(status.UpCount) }</span>
				<span class="text-4xl text-base-content/15 mx-0.5 -mt-0.5 rotate-12">/</span>
				<span class="text-xl text-base-content/40 mt-6">{ fmt.Sprint(status.TotalCount) }</span>
			</div>
			<span class="eyebrow mt-3">awake</span>
		</div>
	</div>
}

type ringDot struct {
	X, Y, R string
	Class   string
	Name    string
}

// ringDots spaces the counted components (everything but scaled-to-zero ones) evenly around the ring, starting at the top
func ringDots(resources []monitor.Resource, mode string) []ringDot {
	counted := make([]monitor.Resource, 0, len(resources))
	for _, group := range groupResources(resources) {
		for _, r := range group.Resources {
			if r.State != monitor.StateOff {
				counted = append(counted, r)
			}
		}
	}
	radius := 1.8
	if len(counted) > 36 {
		radius = 1.2
	}
	dots := make([]ringDot, 0, len(counted))
	for i, r := range counted {
		angle := 2*math.Pi*float64(i)/float64(len(counted)) - math.Pi/2
		_, color, motion := health(r, mode)
		dots = append(dots, ringDot{
			X:     fmt.Sprintf("%.2f", 50+44*math.Cos(angle)),
			Y:     fmt.Sprintf("%.2f", 50+44*math.Sin(angle)),
			R:     fmt.Sprintf("%.1f", radius),
			Class: color + " " + motion,
			Name:  r.Name,
		})
	}
	return dots
}

templ count(label string, n int, color, title string) {
	<div class="flex items-baseline gap-4" title={ title }>
		<span class={ "dot self-center", countColor(n, color), templ.KV("opacity-30", n == 0) }></span>
		<span class={ "font-serif text-3xl leading-none w-8", countColor(n, color) }>{ fmt.Sprint(n) }</span>
		<span class="eyebrow">{ label }</span>
	</div>
}

// ResourceTable shows one drawer per project: a single line with each component as a dot, opening to
// the components' checks.
templ ResourceTable(groups []resourceGroup, mode string) {
	<div>
		for _, group := range groups {
			@drawer(group, mode)
		}
		if len(groups) == 0 {
			<p class="text-center py-10 text-base-content/40">nothing here</p>
		}
	</div>
}

templ drawer(group resourceGroup, mode string) {
	{{ label, color, motion := groupHealth(group.Resources, mode) }}
	<details class="drawer-row" data-drawer={ group.Name }>
		<summary class="flex items-center gap-4 py-2.5 cursor-pointer select-none">
			<span class="chevron text-base-content/25 text-xs w-2">›</span>
			<span class="font-mono text-[13px] whitespace-nowrap">{ group.Name }</span>
			<span class="flex items-center gap-1.5">
				for _, r := range group.Resources {
					{{ _, c, _ := health(r, mode) }}
					<span class={ "dot", c } title={ r.Name }></span>
				}
			</span>
			<span class="ml-auto">
				<span class={ "state text-sm", color }>
					<span class={ "dot", motion }></span>
					<span>{ label }</span>
				</span>
			</span>
		</summary>
		<div class="overflow-x-auto pl-6 pb-3">
			<table class="quiet-table compact table-fixed">
				<tbody>
					for _, resource := range group.Resources {
						@ResourceRow(resource, mode, true)
					}
				</tbody>
			</table>
		</div>
	</details>
}

templ ResourceRow(resource monitor.Resource, mode string, nested bool) {
	<tr>
		<td class="w-[45%]">
			<span class={ "font-mono text-[13px] whitespace-nowrap", templ.KV("text-base-content/70", nested) }>{ resource.Name }</span>
			if resource.Type == "Job" {
				<span class="eyebrow ml-2">job</span>
			}
			if mode == "docker" && resource.Labels["id"] != "" {
				<div class="text-xs text-base-content/40 font-mono">{ resource.Labels["id"] }</div>
			}
		</td>
		<td class="w-[20%]">
			@HealthBadge(resource, mode)
		</td>
		<td class="hidden sm:table-cell">
			@CheckCell(resource)
		</td>
		if mode != "docker" {
			<td class="hidden md:table-cell font-mono text-xs text-base-content/50 whitespace-nowrap">
				if resource.Ping != nil && resource.Ping.StartedAt != nil {
					<span>{ uptime(*resource.Ping.StartedAt) }</span>
				} else {
					<span class="text-base-content/20">—</span>
				}
				if resource.Ping != nil && resource.Ping.Restarts > 0 {
					<span class="text-warning" title="Container restarts in this pod">{ " · " + plural(int(resource.Ping.Restarts), "restart") }</span>
				}
			</td>
		}
	</tr>
}

templ HealthBadge(resource monitor.Resource, mode string) {
	{{ label, color, motion := health(resource, mode) }}
	<span class={ "state", color }>
		<span class={ "dot", motion }></span>
		<span>{ label }</span>
	</span>
}

// CheckCell says how health was determined: the probe kami called and its result, or why there wasn't one
templ CheckCell(resource monitor.Resource) {
	if p := resource.Ping; p == nil {
		<span class="text-base-content/40">{ strings.ToLower(resource.Status) }</span>
	} else {
		<div class="flex items-center gap-3 font-mono text-xs">
			switch p.Probe {
				case "http":
					<span class="text-base-content/50" title={ p.Path }>{ "GET " + truncate(p.Path, 32) }</span>
				case "tcp":
					<span class="text-base-content/50">{ fmt.Sprintf("tcp :%d", p.Port) }</span>
				case "exec":
					<span class="text-warning/70" title="exec probes run inside the container, so kami can't call them. This only reflects the pod's Ready flag.">exec · not callable</span>
				default:
					<span class="text-warning/70" title="Add a readinessProbe to this workload in mirage so kami can check it.">no probe</span>
			}
			if p.Verified() {
				if p.OK {
					if p.Probe == "tcp" {
						<span class="text-success/80">open</span>
					} else {
						<span class="text-success/80">{ fmt.Sprint(p.StatusCode) }</span>
					}
					<span class="text-base-content/30">{ fmt.Sprintf("%dms", p.LatencyMs) }</span>
				} else if resource.State == monitor.StateUnresponsive {
					<span class="text-error truncate max-w-xs" title={ p.Error }>{ p.Error }</span>
				} else {
					<span class="text-base-content/30">not called</span>
				}
			}
		</div>
	}
}

type resourceGroup struct {
	Name      string
	Resources []monitor.Resource
}

func groupResources(resources []monitor.Resource) []resourceGroup {
	byName := make(map[string][]monitor.Resource)
	for _, r := range resources {
		byName[r.Group] = append(byName[r.Group], r)
	}

	groups := make([]resourceGroup, 0, len(byName))
	for name, rs := range byName {
		sort.Slice(rs, func(i, j int) bool { return rs[i].Name < rs[j].Name })
		groups = append(groups, resourceGroup{Name: name, Resources: rs})
	}
	sort.Slice(groups, func(i, j int) bool { return groups[i].Name < groups[j].Name })
	return groups
}

// health returns a lowercase label, its tint, and whether the dot breathes (alive) or holds still
func health(r monitor.Resource, mode string) (string, string, string) {
	switch r.State {
	case monitor.StateUp:
		if mode == "docker" {
			return "running", "text-success", "breathe"
		}
		return "up", "text-success", "breathe"
	case monitor.StateDown:
		if mode == "docker" {
			return "stopped", "text-error", ""
		}
		return "down", "text-error", ""
	case monitor.StateUnresponsive:
		return "not responding", "text-error", ""
	case monitor.StateDegraded:
		return fmt.Sprintf("degraded %d/%d", r.Current, r.Desired), "text-warning", "breathe-fast"
	case monitor.StateOff:
		return "off", "text-base-content/30", ""
	case monitor.StateSucceeded:
		return "succeeded", "text-success/60", ""
	case monitor.StateRunning:
		return "running", "text-info", "breathe-fast"
	case monitor.StateFailed:
		return "failed", "text-error", ""
	default:
		return strings.ToLower(r.State), "text-base-content/40", ""
	}
}

// groupHealth sums up a project by its worst component
func groupHealth(rs []monitor.Resource, mode string) (string, string, string) {
	var down, degraded, running, up, off int
	for _, r := range rs {
		switch r.State {
		case monitor.StateDown, monitor.StateUnresponsive, monitor.StateFailed:
			down++
		case monitor.StateDegraded:
			degraded++
		case monitor.StateRunning:
			running++
		case monitor.StateOff:
			off++
		default:
			up++
		}
	}
	switch {
	case len(rs) == 1:
		return health(rs[0], mode)
	case down > 0:
		return fmt.Sprintf("%d of %d down", down, len(rs)), "text-error", ""
	case degraded > 0:
		return fmt.Sprintf("%d degraded", degraded), "text-warning", "breathe-fast"
	case running > 0:
		return fmt.Sprintf("%d running", running), "text-info", "breathe-fast"
	case off == len(rs):
		return "off", "text-base-content/30", ""
	default:
		return fmt.Sprintf("all %d up", up+off), "text-success", "breathe"
	}
}

func countColor(n int, color string) string {
	if n > 0 {
		return color
	}
	return "text-base-content/25"
}

func uptime(started time.Time) string {
	return strings.TrimSuffix(k8s.HumanizeAge(time.Since(started)), " ago")
}

func truncate(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "…"
}

func plural(n int, word string) string {
	if n == 1 {
		return fmt.Sprintf("%d %s", n, word)
	}
	return fmt.Sprintf("%d %ss", n, word)
}
