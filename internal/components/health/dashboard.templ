package health

import (
	"fmt"
	"kami/internal/components/layout"
	"kami/internal/k8s"
	"kami/internal/monitor"
	"sort"
	"strings"
	"time"
)

templ Dashboard(mode string) {
	@layout.Base("Health Dashboard", "health") {
		<div class="space-y-6">
			<!-- One poller refreshes every region with a single request -->
			<div
				hx-get="/partials/status"
				hx-trigger="load, every 10s"
				hx-swap="none"
				hx-select-oob="#summary,#resources-container,#last-update"
			></div>
			if mode == "docker" {
				<div class="bg-info/10 border border-info/30 rounded-lg px-4 py-2 text-sm flex items-center gap-2">
					<span class="badge badge-sm badge-info">🐳 Docker</span>
					<span class="text-info">Local development mode</span>
				</div>
			}
			<div id="summary">
				@spinner()
			</div>
			<div class="bg-base-100 border border-base-300 rounded-box p-6">
				<div id="resources-container">
					@spinner()
				</div>
			</div>
			<div class="text-center text-base-content/50 text-sm">
				Last updated: <span id="last-update">never</span> • Auto-refresh every 10s
			</div>
		</div>
	}
}

templ spinner() {
	<div class="flex justify-center py-8">
		<span class="loading loading-spinner loading-md"></span>
	</div>
}

templ StandaloneMode() {
	<div id="summary" class="alert alert-warning shadow-lg">
		<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
		</svg>
		<div>
			<h3 class="font-bold">Standalone Mode</h3>
			<div class="text-sm">Kubernetes client not available. Running without cluster monitoring.</div>
		</div>
	</div>
}

templ ErrorState(message string) {
	<div id="summary" class="alert alert-error shadow-lg">
		<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
		</svg>
		<div>
			<h3 class="font-bold">Can't read cluster status</h3>
			<div class="text-sm font-mono">{ message }</div>
		</div>
	</div>
}

templ StatusCards(status *monitor.Status, mode string) {
	<div id="summary" class="stats stats-vertical sm:stats-horizontal w-full bg-base-100 shadow">
		<div class="stat">
			<div class="stat-title">Up</div>
			<div class="stat-value text-success">{ fmt.Sprint(status.UpCount) }<span class="text-base-content/40 text-2xl">/{ fmt.Sprint(status.TotalCount) }</span></div>
		</div>
		<div class="stat">
			<div class="stat-title">Degraded</div>
			<div class={ "stat-value", countColor(status.DegradedCount, "text-warning") }>{ fmt.Sprint(status.DegradedCount) }</div>
		</div>
		<div class="stat">
			<div class="stat-title">Down</div>
			<div class={ "stat-value", countColor(status.DownCount, "text-error") }>{ fmt.Sprint(status.DownCount) }</div>
		</div>
		if mode == "kubernetes" {
			<div class="stat">
				<div class="stat-title">Unverified</div>
				<div class={ "stat-value", countColor(status.UnverifiedCount, "text-warning") }>{ fmt.Sprint(status.UnverifiedCount) }</div>
				<div class="stat-desc">Up, but kami can't call their health check</div>
			</div>
		}
	</div>
	<div id="resources-container">
		@ResourceTable(groupResources(status.Resources), mode)
	</div>
	<span id="last-update">{ status.UpdatedAt.Format("15:04:05 UTC") }</span>
}

templ ResourceTable(groups []resourceGroup, mode string) {
	<div class="overflow-x-auto">
		<table class="table w-full">
			<thead>
				<tr>
					<th>Component</th>
					<th>Health</th>
					if mode == "docker" {
						<th>Status</th>
					} else {
						<th>Check</th>
						<th>Uptime</th>
					}
				</tr>
			</thead>
			for _, group := range groups {
				<tbody>
					// Projects with one component get a single row instead of a header repeating its name
					if len(group.Resources) > 1 {
						<tr>
							<th colspan="4" class="font-semibold">
								<span class="flex items-center gap-2">
									<i class={ "w-4 text-center", getServiceIconClass(group.Name) }></i>
									<span>{ group.Name }</span>
								</span>
							</th>
						</tr>
					}
					for _, resource := range group.Resources {
						@ResourceRow(resource, mode, len(group.Resources) > 1)
					}
				</tbody>
			}
			if len(groups) == 0 {
				<tbody>
					<tr>
						<td colspan="4" class="text-center py-8 text-base-content/50">No resources found.</td>
					</tr>
				</tbody>
			}
		</table>
	</div>
}

templ ResourceRow(resource monitor.Resource, mode string, nested bool) {
	<tr class="hover">
		<td class={ templ.KV("pl-12", nested) }>
			<div class="flex items-center gap-2">
				if !nested {
					<i class={ "w-4 text-center", getServiceIconClass(resource.Group) }></i>
				}
				<span class="font-mono text-sm">{ resource.Name }</span>
				if resource.Type == "Job" {
					<span class="badge badge-xs badge-ghost">job</span>
				}
			</div>
			if mode == "docker" && resource.Labels["id"] != "" {
				<div class="text-xs text-base-content/50 font-mono">{ resource.Labels["id"] }</div>
			}
		</td>
		<td>
			@HealthBadge(resource, mode)
		</td>
		<td>
			@CheckCell(resource)
		</td>
		if mode != "docker" {
			<td class="text-sm font-mono">
				if resource.Ping != nil && resource.Ping.StartedAt != nil {
					<span>{ uptime(*resource.Ping.StartedAt) }</span>
				} else {
					<span class="text-base-content/40">-</span>
				}
				if resource.Ping != nil && resource.Ping.Restarts > 0 {
					<span class="text-warning" title="Container restarts in this pod">{ fmt.Sprintf(" · %d restarts", resource.Ping.Restarts) }</span>
				}
			</td>
		}
	</tr>
}

templ HealthBadge(resource monitor.Resource, mode string) {
	{{ label, class := health(resource, mode) }}
	<div class={ "badge badge-sm font-semibold", class }>{ label }</div>
}

// CheckCell says how health was determined: the probe kami called and its result, or why there wasn't one
templ CheckCell(resource monitor.Resource) {
	if p := resource.Ping; p == nil {
		<span class="text-sm text-base-content/60">{ resource.Status }</span>
	} else {
		<div class="flex items-center gap-2 text-sm font-mono">
			switch p.Probe {
				case "http":
					<span class="text-base-content/70" title={ p.Path }>{ "GET " + truncate(p.Path, 32) }</span>
				case "tcp":
					<span class="text-base-content/70">{ fmt.Sprintf("TCP :%d", p.Port) }</span>
				case "exec":
					<span class="text-warning/80" title="exec probes run inside the container, so kami can't call them. This only reflects the pod's Ready flag.">exec probe · not callable</span>
				default:
					<span class="text-warning" title="Add a readinessProbe to this workload in mirage so kami can check it.">no probe declared</span>
			}
			if p.Verified() {
				if p.OK {
					if p.Probe == "tcp" {
						<span class="text-success">open</span>
					} else {
						<span class="text-success">{ fmt.Sprint(p.StatusCode) }</span>
					}
					<span class="text-base-content/50">{ fmt.Sprintf("%dms", p.LatencyMs) }</span>
				} else if resource.State == monitor.StateUnresponsive {
					<span class="text-error truncate max-w-xs" title={ p.Error }>{ p.Error }</span>
				} else {
					<span class="text-base-content/50">not called</span>
				}
			}
		</div>
	}
}

type resourceGroup struct {
	Name      string
	Resources []monitor.Resource
}

func groupResources(resources []monitor.Resource) []resourceGroup {
	byName := make(map[string][]monitor.Resource)
	for _, r := range resources {
		byName[r.Group] = append(byName[r.Group], r)
	}

	groups := make([]resourceGroup, 0, len(byName))
	for name, rs := range byName {
		sort.Slice(rs, func(i, j int) bool { return rs[i].Name < rs[j].Name })
		groups = append(groups, resourceGroup{Name: name, Resources: rs})
	}
	sort.Slice(groups, func(i, j int) bool { return groups[i].Name < groups[j].Name })
	return groups
}

func health(r monitor.Resource, mode string) (string, string) {
	switch r.State {
	case monitor.StateUp:
		if mode == "docker" {
			return "Running", "badge-success text-white"
		}
		return "Up", "badge-success text-white"
	case monitor.StateDown:
		if mode == "docker" {
			return "Stopped", "badge-error text-white"
		}
		return "Down", "badge-error text-white"
	case monitor.StateUnresponsive:
		return "Not responding", "badge-error text-white"
	case monitor.StateDegraded:
		return fmt.Sprintf("Degraded %d/%d", r.Current, r.Desired), "badge-warning text-black"
	case monitor.StateOff:
		return "Off", "badge-ghost"
	case monitor.StateSucceeded:
		return "Succeeded", "badge-success badge-outline"
	case monitor.StateRunning:
		return "Running", "badge-info text-white"
	case monitor.StateFailed:
		return "Failed", "badge-error text-white"
	default:
		return r.State, "badge-ghost"
	}
}

func countColor(n int, color string) string {
	if n > 0 {
		return color
	}
	return "text-base-content/40"
}

func uptime(started time.Time) string {
	return strings.TrimSuffix(k8s.HumanizeAge(time.Since(started)), " ago")
}

func truncate(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "…"
}

func getServiceIconClass(name string) string {
	// Match service names to their icons using prefix matching for flexibility
	switch {
	case strings.HasPrefix(name, "doppler"):
		return "fa-solid fa-record-vinyl text-primary"
	case strings.HasPrefix(name, "augur"):
		return "fa-solid fa-satellite text-secondary"
	case strings.HasPrefix(name, "luna"):
		return "fa-solid fa-map text-primary"
	case strings.HasPrefix(name, "kami"):
		return "fa-solid fa-heart-pulse text-error"
	case strings.HasPrefix(name, "noctis-prefect") || strings.HasPrefix(name, "prefect"):
		return "fa-solid fa-server text-info"
	case strings.HasPrefix(name, "noctis-postgres"):
		return "fa-solid fa-database text-accent"
	case strings.HasPrefix(name, "noctis"):
		return "fa-solid fa-moon text-secondary"
	case strings.HasPrefix(name, "oracle"):
		return "fa-solid fa-clock text-warning"
	case strings.HasPrefix(name, "cuneiform"):
		return "fa-solid fa-key text-warning"
	case strings.HasPrefix(name, "ouroboros"):
		return "fa-solid fa-infinity text-success"
	case strings.HasPrefix(name, "garage"):
		return "fa-solid fa-hard-drive text-info"
	case strings.HasPrefix(name, "atlas") || strings.HasPrefix(name, "postgres"):
		return "fa-solid fa-database text-accent"
	case strings.HasPrefix(name, "redis"):
		return "fa-solid fa-server text-error"
	default:
		return "fa-solid fa-circle text-base-content/50"
	}
}
