package health

import (
	"fmt"
	"kami/internal/components/layout"
	"kami/internal/k8s"
	"kami/internal/monitor"
	"kami/internal/uptime"
	"sort"
	"strings"
	"time"
)

templ Dashboard(mode string) {
	@layout.Base("health", "health") {
		<div class="space-y-10">
			<!-- One poller refreshes every region with a single request -->
			<div
				hx-get="/partials/status"
				hx-trigger="load, every 10s"
				hx-swap="none"
				hx-select-oob="#summary,#resources-container,#last-update"
			></div>
			if mode == "docker" {
				<p class="eyebrow">local docker mode</p>
			}
			<div id="summary">
				@spinner()
			</div>
			<div id="resources-container"></div>
			<p class="eyebrow text-center">
				<span id="last-update">…</span> · every 10s
			</p>
		</div>
	}
}

templ spinner() {
	<div class="flex justify-center py-10 text-base-content/40">
		<span class="dot breathe-fast"></span>
	</div>
}

templ StandaloneMode() {
	<div id="summary" class="notice border-warning/50">
		<p class="text-warning">standalone</p>
		<p class="text-base-content/50">No Kubernetes client, so there is no cluster to watch.</p>
	</div>
}

templ ErrorState(message string) {
	<div id="summary" class="notice border-error/50">
		<p class="text-error">can't read cluster status</p>
		<p class="font-mono text-xs text-base-content/50 break-all mt-1">{ message }</p>
	</div>
}

templ StatusCards(status *monitor.Status, mode string, history *History) {
	<div id="summary">
		@overallUptime(status, history)
		<p class="mt-6 text-sm text-base-content/40">
			for i, t := range tallies(status.Resources, mode) {
				if i > 0 {
					<span class="text-base-content/20">{ " · " }</span>
				}
				<span title={ t.Title }><span class={ "font-serif text-base", t.Color }>{ fmt.Sprint(t.N) }</span> { t.Label }</span>
			}
		</p>
	</div>
	{{ services, jobs := splitJobs(status.Resources) }}
	<div id="resources-container" class="space-y-12">
		@ResourceTable(groupResources(services), mode, history)
		if len(jobs) > 0 {
			@JobList(jobs, history)
		}
	</div>
	<span id="last-update">{ status.UpdatedAt.Format("15:04:05 UTC") }</span>
}

// overallUptime is the average of every project's uptime over the window, set large in the serif
templ overallUptime(status *monitor.Status, history *History) {
	{{ whole, frac, ok := splitPercent(history.overall(groupResources(status.Resources))) }}
	<div>
		<div class="font-serif leading-none text-base-content/90">
			if ok {
				<span class="text-6xl">{ whole }</span><span class="text-3xl text-base-content/40">{ frac }</span>
			} else {
				<span class="text-6xl text-base-content/20">—</span>
			}
		</div>
		<p class="eyebrow mt-4" title={ history.note() }>{ history.label() }</p>
	</div>
}

// ResourceTable shows one drawer per project: its daily uptime bars and percentage, opening to
// the components' checks.
templ ResourceTable(groups []resourceGroup, mode string, history *History) {
	<div>
		<h2 class="eyebrow mb-3">services</h2>
		for _, group := range groups {
			@drawer(group, mode, history)
		}
		if len(groups) == 0 {
			<p class="text-center py-10 text-base-content/40">nothing here</p>
		} else {
			<div class="flex items-center gap-2 sm:gap-4 pt-2 eyebrow whitespace-nowrap" aria-hidden="true">
				<span class="w-2"></span>
				<span class="uptime-name"></span>
				<span class="flex-1 min-w-0 flex justify-center sm:justify-between">
					<span class="hidden sm:inline">{ fmt.Sprint(UptimeDays) } days ago</span>
					<span class="hidden sm:inline">today</span>
					<span class="sm:hidden">last { fmt.Sprint(mobileDays) } days</span>
				</span>
				<span class="uptime-pct"></span>
				<span class="uptime-state"></span>
			</div>
		}
	</div>
}

templ drawer(group resourceGroup, mode string, history *History) {
	{{ word, color := projectState(group.Resources) }}
	{{ days := history.days(uptime.GroupKey(group.Name)) }}
	<details class="drawer-row" data-drawer={ group.Name }>
		<summary class="flex items-center gap-2 sm:gap-4 py-2.5 cursor-pointer select-none">
			<span class="chevron text-base-content/25 text-xs w-2">›</span>
			<span class="uptime-name font-mono text-[13px] truncate">{ group.Name }</span>
			@bars(days)
			@percent(days)
			<span class={ "uptime-state text-sm", color }>{ word }</span>
		</summary>
		<div class="pb-2">
			for _, resource := range group.Resources {
				@ResourceRow(resource, mode, history.days(resource.Name))
			}
		</div>
	</details>
}

// bars draws one thin stroke per day, tinted by that day's uptime; phones only get the last month
templ bars(days []uptime.Day) {
	<span class="flex-1 min-w-0 flex items-stretch gap-px sm:gap-[2px] h-6">
		for i, d := range days {
			<span class={ "uptime-bar", barColor(d), templ.KV("hidden sm:block", i < len(days)-mobileDays) } title={ barTitle(d) }></span>
		}
	</span>
}

templ percent(days []uptime.Day) {
	{{ total := uptime.Sum(days) }}
	<span class={ "uptime-pct font-mono text-xs text-right", percentColor(total) }>
		if total.Total() > 0 {
			{ formatPercent(total.Uptime()) }
		} else {
			—
		}
	</span>
}

// ResourceRow is one component inside a drawer, on the same columns as its project's row so the
// percentages and states line up: name and check in the bars' space, then uptime and state
templ ResourceRow(resource monitor.Resource, mode string, days []uptime.Day) {
	{{ label, color := health(resource, mode) }}
	<div class="flex items-center gap-2 sm:gap-4 py-1.5">
		<span class="w-2"></span>
		<span class="flex-1 min-w-0 flex items-baseline gap-4 pl-4">
			<span class="font-mono text-[13px] text-base-content/60 truncate">{ resource.Name }</span>
			<span class="hidden sm:flex items-baseline gap-3 min-w-0 font-mono text-xs text-base-content/40">
				@CheckCell(resource)
				@podDetails(resource, mode)
			</span>
		</span>
		@percent(days)
		<span class={ "uptime-state text-sm", color }>{ label }</span>
	</div>
}

// podDetails is how many pods are ready when some aren't, the pod's age and restarts, or the
// container id in docker mode
templ podDetails(resource monitor.Resource, mode string) {
	if mode == "docker" {
		if id := resource.Labels["id"]; id != "" {
			<span class="text-base-content/25">{ id }</span>
		}
	} else if p := resource.Ping; p != nil {
		if resource.State == monitor.StateDegraded {
			<span class="text-warning/80 whitespace-nowrap">{ fmt.Sprintf("%d/%d ready", resource.Current, resource.Desired) }</span>
		}
		if p.StartedAt != nil {
			<span class="text-base-content/25 whitespace-nowrap" title="Pod age">{ "· " + podAge(*p.StartedAt) }</span>
		}
		if p.Restarts > 0 {
			<span class="text-warning/80 whitespace-nowrap" title="Container restarts in this pod">{ plural(int(p.Restarts), "restart") }</span>
		}
	}
}

// JobList gives CronJobs and Jobs their own rows: daily bars of their latest run's result, and
// when it ran
templ JobList(jobs []monitor.Resource, history *History) {
	<div>
		<h2 class="eyebrow mb-3">jobs</h2>
		for _, job := range jobs {
			{{ word, color := jobState(job) }}
			<div class="job-row flex items-center gap-2 sm:gap-4 py-2.5">
				<span class="w-2"></span>
				<span class="uptime-name font-mono text-[13px] truncate">{ job.Name }</span>
				@bars(history.days(job.Name))
				<span class="uptime-pct font-mono text-xs text-right text-base-content/40 whitespace-nowrap">{ lastRun(job) }</span>
				<span class={ "uptime-state text-sm", color }>{ word }</span>
			</div>
		}
	</div>
}

// CheckCell says how health was determined: the probe and its result, or why there wasn't one
templ CheckCell(resource monitor.Resource) {
	if p := resource.Ping; p == nil {
		<span>{ strings.ToLower(resource.Status) }</span>
	} else {
		switch p.Probe {
			case "http":
				<span class="truncate" title={ p.Path }>{ "GET " + truncate(p.Path, 32) }</span>
			case "tcp":
				<span class="whitespace-nowrap">{ fmt.Sprintf("tcp :%d", p.Port) }</span>
			case "exec":
				<span class="truncate" title="The kubelet runs this inside the container; kami reads the result from the pod's Ready flag">{ execLabel(p.Command) }</span>
			default:
				<span class="text-warning/70" title="Add a readinessProbe to this workload in mirage so kami can check it">no probe</span>
		}
		if p.OK {
			switch p.Probe {
				case "http":
					<span class="text-success/80">{ fmt.Sprint(p.StatusCode) }</span>
					<span class="text-base-content/25">{ fmt.Sprintf("%dms", p.LatencyMs) }</span>
				case "tcp":
					<span class="text-success/80">open</span>
					<span class="text-base-content/25">{ fmt.Sprintf("%dms", p.LatencyMs) }</span>
				case "exec":
					<span class="text-success/80">ready</span>
			}
		} else if p.Error != "" {
			<span class="text-error/80 truncate" title={ p.Error }>{ p.Error }</span>
		}
	}
}

type resourceGroup struct {
	Name      string
	Resources []monitor.Resource
}

func groupResources(resources []monitor.Resource) []resourceGroup {
	byName := make(map[string][]monitor.Resource)
	for _, r := range resources {
		byName[r.Group] = append(byName[r.Group], r)
	}

	groups := make([]resourceGroup, 0, len(byName))
	for name, rs := range byName {
		sort.Slice(rs, func(i, j int) bool { return rs[i].Name < rs[j].Name })
		groups = append(groups, resourceGroup{Name: name, Resources: rs})
	}
	sort.Slice(groups, func(i, j int) bool { return groups[i].Name < groups[j].Name })
	return groups
}

// health returns a component's lowercase label and its tint
func health(r monitor.Resource, mode string) (string, string) {
	switch r.State {
	case monitor.StateUp:
		if mode == "docker" {
			return "running", "text-success"
		}
		return "healthy", "text-success"
	case monitor.StateDown:
		if mode == "docker" {
			return "stopped", "text-error"
		}
		return "down", "text-error"
	case monitor.StateUnresponsive:
		return "unresponsive", "text-error"
	case monitor.StateDegraded:
		return "degraded", "text-warning"
	case monitor.StateOff:
		return "off", "text-base-content/30"
	case monitor.StateRunning:
		return "running", "text-info"
	default:
		return strings.ToLower(r.State), "text-base-content/40"
	}
}

// projectState sums up a project in one word: down when nothing in it is up, degraded when
// only part of it is, off when it's scaled to zero
func projectState(rs []monitor.Resource) (string, string) {
	var up, degraded, down int
	for _, r := range rs {
		level, counted := monitor.Level(r.State)
		switch {
		case !counted:
		case level == uptime.Up:
			up++
		case level == uptime.Degraded:
			degraded++
		default:
			down++
		}
	}
	switch {
	case up+degraded+down == 0:
		return "off", "text-base-content/30"
	case down > 0 && up+degraded == 0:
		return "down", "text-error"
	case down > 0 || degraded > 0:
		return "degraded", "text-warning"
	default:
		return "healthy", "text-success"
	}
}

func jobState(r monitor.Resource) (string, string) {
	switch r.State {
	case monitor.StateSucceeded:
		return "healthy", "text-success"
	case monitor.StateRunning:
		return "running", "text-info"
	case monitor.StatePending:
		return "pending", "text-warning"
	default:
		return "failed", "text-error"
	}
}

// lastRun turns a job's "Ran 3h ago" or "Started 2m ago" into "3h ago"
func lastRun(r monitor.Resource) string {
	for _, prefix := range []string{"Ran ", "Started "} {
		if rest, ok := strings.CutPrefix(r.Status, prefix); ok {
			return rest
		}
	}
	return strings.ToLower(r.Status)
}

// splitJobs separates Jobs, which run and finish, from the services that should stay up
func splitJobs(resources []monitor.Resource) ([]monitor.Resource, []monitor.Resource) {
	var services, jobs []monitor.Resource
	for _, r := range resources {
		if r.Type == "Job" {
			jobs = append(jobs, r)
		} else {
			services = append(services, r)
		}
	}
	sort.Slice(jobs, func(i, j int) bool { return jobs[i].Name < jobs[j].Name })
	return services, jobs
}

func execLabel(command string) string {
	if command == "" {
		return "exec"
	}
	return command
}

func podAge(started time.Time) string {
	return strings.TrimSuffix(k8s.HumanizeAge(time.Since(started)), " ago")
}

func truncate(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "…"
}

func plural(n int, word string) string {
	if n == 1 {
		return fmt.Sprintf("%d %s", n, word)
	}
	return fmt.Sprintf("%d %ss", n, word)
}

type tally struct {
	N            int
	Label, Color string
	Title        string
}

// tallies counts services by health for the line under the uptime, leaving out the zeros
func tallies(resources []monitor.Resource, mode string) []tally {
	services, _ := splitJobs(resources)
	var healthy, degraded, down, unverified int
	for _, r := range services {
		level, counted := monitor.Level(r.State)
		switch {
		case !counted:
		case level == uptime.Up:
			healthy++
			if r.Ping != nil && !r.Ping.Verified() {
				unverified++
			}
		case level == uptime.Degraded:
			degraded++
		default:
			down++
		}
	}
	all := []tally{
		{healthy, "healthy", "text-success", ""},
		{degraded, "degraded", "text-warning", ""},
		{down, "down", "text-error", ""},
	}
	if mode == "kubernetes" {
		all = append(all, tally{unverified, "unverified", "text-warning", "Healthy, but kami can't call their health check"})
	}
	shown := make([]tally, 0, len(all))
	for i, t := range all {
		if t.N > 0 || i == 0 {
			shown = append(shown, t)
		}
	}
	return shown
}
