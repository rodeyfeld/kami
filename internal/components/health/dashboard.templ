package health

import (
	"fmt"
	"kami/internal/components/layout"
	"kami/internal/monitor"
)

templ Dashboard(mode string) {
	@layout.Base("Health Dashboard") {
		<div class="space-y-6">
			<!-- Mode indicator -->
			<div class="bg-info/10 border border-info/30 rounded-lg px-4 py-2 text-sm flex items-center gap-2">
				if mode == "kubernetes" {
					<span class="badge badge-sm badge-info">☸️ Kubernetes</span>
					<span class="text-info">Monitoring galaxy namespace</span>
				} else if mode == "docker" {
					<span class="badge badge-sm badge-info">🐳 Docker</span>
					<span class="text-info">Local development mode</span>
				} else {
					<span class="badge badge-sm badge-warning">⚠️ Standalone</span>
					<span class="text-warning">No monitoring backend</span>
				}
			</div>
			<!-- Static Tab Structure -->
			<div class="space-y-8">
				<div role="tablist" class="tabs tabs-lifted tabs-lg">
					<!-- Services Tab -->
					<input type="radio" name="health_tabs" role="tab" class="tab" aria-label="Services" checked="checked"/>
					<div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
						<!-- Polling for Services Table -->
						<div
							hx-get="/api/status"
							hx-trigger="load, every 10s"
							hx-select="#services-table-container"
							hx-swap="outerHTML"
						>
							<div class="flex justify-center py-8">
								<span class="loading loading-spinner loading-md"></span>
							</div>
						</div>
					</div>
					<!-- Infrastructure Tab -->
					<input type="radio" name="health_tabs" role="tab" class="tab" aria-label="Infrastructure"/>
					<div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
						<!-- Polling for Infrastructure Table -->
						<div
							hx-get="/api/status"
							hx-trigger="load, every 10s"
							hx-select="#infra-table-container"
							hx-swap="outerHTML"
						>
							<div class="flex justify-center py-8">
								<span class="loading loading-spinner loading-md"></span>
							</div>
						</div>
					</div>
				</div>
				<!-- Last Updated -->
				<div class="text-center text-base-content/50 text-sm">
					Last updated: <span id="last-update">just now</span> • Auto-refresh every 10s
				</div>
			</div>
		</div>
	}
}

templ StandaloneMode() {
	<div class="alert alert-warning shadow-lg">
		<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
		</svg>
		<div>
			<h3 class="font-bold">Standalone Mode</h3>
			<div class="text-sm">Kubernetes client not available. Running without cluster monitoring.</div>
		</div>
	</div>
}

templ ErrorState(message string) {
	<div class="alert alert-error shadow-lg">
		<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
		</svg>
		<div>
			<h3 class="font-bold">Error</h3>
			<div class="text-sm">{ message }</div>
		</div>
	</div>
}

templ StatusCards(status *monitor.Status, mode string) {
	<!-- We wrap the response in a div that matches hx-select if needed, but we target specific IDs below -->
	<div class="hidden">
		<!-- This wrapper ensures we don't return multiple root elements if that matters, though templ handles it -->
	</div>
	<!-- Services Table Container -->
	<div id="services-table-container" hx-get="/api/status" hx-trigger="every 10s" hx-select="#services-table-container" hx-swap="outerHTML">
		@ResourceTable(filterResources(status.Resources, "Service"), mode)
	</div>
	<!-- Infrastructure Table Container -->
	<div id="infra-table-container" hx-get="/api/status" hx-trigger="every 10s" hx-select="#infra-table-container" hx-swap="outerHTML">
		@ResourceTable(filterResources(status.Resources, "Infrastructure"), mode)
	</div>
}

templ ResourceTable(resources []monitor.Resource, mode string) {
	<div class="overflow-x-auto">
		<table class="table table-zebra w-full">
			<thead>
				<tr>
					<th>Name</th>
					<th>Type</th>
					if mode == "docker" {
						<th>Project</th>
					} else {
						<th>Replicas</th>
					}
					<th>Status</th>
					<th>Info</th>
				</tr>
			</thead>
			<tbody>
				for _, resource := range resources {
					@ResourceRow(resource, mode)
				}
				if len(resources) == 0 {
					<tr>
						<td colspan="5" class="text-center py-8 text-base-content/50">
							No resources found in this category.
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ ResourceRow(resource monitor.Resource, mode string) {
	<tr class="hover">
		<td>
			<div class="font-semibold flex items-center gap-2">
				if mode != "docker" {
					<span class={ getServiceIconClass(resource.Name) }></span>
				}
				<span>{ resource.Name }</span>
			</div>
			if mode == "docker" && resource.Labels["id"] != "" {
				<div class="text-xs text-base-content/50 font-mono">{ resource.Labels["id"][:12] }</div>
			}
		</td>
		<td>
			<span class="badge badge-sm badge-ghost">{ resource.Type }</span>
		</td>
		if mode == "docker" {
			<td>
				if resource.Labels["project"] != "" {
					<span class="badge badge-sm badge-primary text-white font-semibold">{ resource.Labels["project"] }</span>
				} else {
					<span class="text-base-content/50">-</span>
				}
			</td>
		} else {
			<td>
				if resource.Desired > 0 && resource.Type != "Job" {
					<div class="flex items-center gap-2">
						<progress
							class={ "progress progress-sm w-20", getProgressColor(resource.State) }
							value={ fmt.Sprintf("%d", resource.Current) }
							max={ fmt.Sprintf("%d", resource.Desired) }
						></progress>
						<span class="text-sm font-mono">{ fmt.Sprintf("%d/%d", resource.Current, resource.Desired) }</span>
					</div>
				} else {
					<span class="text-base-content/50">-</span>
				}
			</td>
		}
		<td>
			@StatusBadge(resource.State, mode)
		</td>
		<td>
			<div class="text-sm text-base-content/70 truncate max-w-xs">{ resource.Status }</div>
		</td>
	</tr>
}

templ StatusBadge(state string, mode string) {
	if mode == "docker" && state == "healthy" {
		<div class="badge badge-success badge-sm text-white font-semibold">✓ Running</div>
	} else if mode == "docker" && state == "unhealthy" {
		<div class="badge badge-error badge-sm text-white font-semibold">✗ Stopped</div>
	} else {
		switch state {
			case "Healthy", "healthy":
				<div class="badge badge-success badge-sm text-white font-semibold">✓ Healthy</div>
			case "Degraded":
				<div class="badge badge-warning badge-sm text-black font-semibold">⚠ Degraded</div>
			case "Unhealthy", "unhealthy":
				<div class="badge badge-error badge-sm text-white font-semibold">✗ Unhealthy</div>
			case "Running":
				<div class="badge badge-info badge-sm text-white font-semibold">● Running</div>
			default:
				<div class="badge badge-ghost badge-sm font-semibold">? { state }</div>
		}
	}
}

func getProgressColor(status string) string {
	switch status {
	case "Healthy", "healthy":
		return "progress-success"
	case "Degraded":
		return "progress-warning"
	case "Unhealthy", "unhealthy":
		return "progress-error"
	default:
		return "progress-ghost"
	}
}

func getServiceIconClass(name string) string {
	// Match service names to their icons
	switch {
	case name == "doppler":
		return "fa-solid fa-record-vinyl text-primary"
	case name == "augur":
		return "fa-solid fa-satellite text-secondary"
	case name == "luna":
		return "fa-solid fa-map text-primary"
	case name == "dreamflow-webserver":
		return "fa-solid fa-wind text-secondary"
	case name == "kami":
		return "fa-solid fa-heart-pulse text-error"
	case name == "enchiridion" || name == "infisical":
		return "fa-solid fa-key text-warning"
	case name == "ouroboros" || name == "woodpecker":
		return "fa-solid fa-infinity text-success"
	case name == "garage":
		return "fa-solid fa-hard-drive text-info"
	case name == "atlas" || name == "postgres":
		return "fa-solid fa-database text-accent"
	case name == "redis":
		return "fa-solid fa-server text-error"
	default:
		return "fa-solid fa-circle text-base-content/50"
	}
}

func filterResources(resources []monitor.Resource, category string) []monitor.Resource {
	filtered := make([]monitor.Resource, 0)
	for _, r := range resources {
		cat := r.Labels["category"]
		if category == "Service" && (cat == "Service" || cat == "") {
			filtered = append(filtered, r)
		} else if category == "Infrastructure" && (cat == "Infrastructure" || cat == "Other") {
			filtered = append(filtered, r)
		}
	}
	return filtered
}
