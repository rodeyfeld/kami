package layout

templ Base(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Kami</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
		</head>
		<body class="min-h-screen bg-base-200">
			<div class="container mx-auto px-4 py-8">
				<header class="mb-8 flex justify-between items-start">
					<div>
						<h1 class="text-4xl font-bold wordmark">神 Kami</h1>
						<p class="text-base-content/70 mt-2">Pinwheel Labs Health Monitor</p>
					</div>
					<nav class="flex items-center gap-1">
						@navLink("/", "fa-heart-pulse", "Health", active == "health")
						@navLink("/deploys", "fa-rocket", "Deploys", active == "deploys")
						<a href="https://pinwheel.fan" class="btn btn-ghost btn-sm gap-2 hover:btn-primary transition-all">
							<i class="fa-solid fa-grip"></i>
							<span class="hidden sm:inline">All Projects</span>
						</a>
					</nav>
				</header>
				<main>
					{ children... }
				</main>
			</div>
			<script type="module" src="/static/dist/index.js"></script>
		</body>
	</html>
}

templ navLink(href string, icon string, label string, active bool) {
	<a href={ templ.SafeURL(href) } class={ "btn btn-sm gap-2", templ.KV("btn-primary", active), templ.KV("btn-ghost", !active) }>
		<i class={ "fa-solid", icon }></i>
		<span class="hidden sm:inline">{ label }</span>
	</a>
}
